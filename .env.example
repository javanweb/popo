# Customer-facing AI is called through these Cloudflare Workers.
# The server requests gemini-3.8-flash first, then gemini-3.7-flash on Worker/API errors.
# Gemini credentials stay in Cloudflare Worker Secrets; never add a Gemini key here.
WORKER_AI_TIMEOUT_MS=60000

# SERVER-ONLY secret with Contents: write access to javanweb/imageatlas.
# Set this in the hosting provider's secret/environment settings, not in frontend VITE_* variables.
IMAGEATLAS_GITHUB_TOKEN=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

# Optional for native Android APK builds only: public backend origin (not a secret).
# Browser deployments use same-origin /api routes and can leave this blank.
VITE_API_BASE_URL=
